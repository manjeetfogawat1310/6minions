APP_NAME=Honey Chain
APP_ENV=development
DEBUG=true

DATABASE_URL=sqlite:///./honey_chain.db

AI_SERVICE_URL=http://localhost:8001
MOCK_AI_MODE=true
AI_TIMEOUT_SECONDS=8

BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_ARTIFACT_PATH=blockchain/artifacts/HoneyTraceability.json
BLOCKCHAIN_REQUIRED=false
BLOCKCHAIN_CONFIRMATIONS=1

PUBLIC_BASE_URL=http://localhost:8000
QR_DIRECTORY=backend/generated_qr
UPLOAD_DIRECTORY=backend/uploads
MAX_REPORT_SIZE_BYTES=5242880

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
```

## Exact Commands

```bash
python -m venv .venv
source .venv/bin/activate
pip install -r requirements.txt
cp .env.example .env
python -m backend.seed
pytest -v
uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000
```

Windows PowerShell:

```powershell
python -m venv .venv
.venv\Scripts\Activate.ps1
pip install -r requirements.txt
Copy-Item .env.example .env
python -m backend.seed
pytest -v
uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000
